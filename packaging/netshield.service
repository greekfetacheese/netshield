[Unit]
Description=NetShield outbound application firewall
Documentation=file:///usr/share/doc/netshield/README.md
DefaultDependencies=no
Before=network-pre.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target
ConditionPathExists=/etc/netshield/config.json

[Service]
Type=simple
ExecStart=/usr/local/bin/netshieldd
Restart=on-failure
RestartSec=2s
UMask=0077

# The daemon needs NET_ADMIN to program nftables and to bind the NFQUEUE sockets it owns.
# It needs SYS_PTRACE and DAC_READ_SEARCH to read /proc/<pid>/exe and /proc/<pid>/fd for
# processes of other users (the resolver runs as its own uid): without them attribution
# silently degrades to Unknown and every DNS lookup would prompt.
# It needs CHOWN because it hands the control socket to the GUI user (chown to
# allowed_uid) after bind: without it the chown fails with EPERM, the socket stays
# root:root and the unprivileged GUI cannot connect.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_CHOWN
NoNewPrivileges=yes

# 0711 gives every local user traversal into the directory without listing it; the
# socket itself stays 0660 and is guarded by the SO_PEERCRED uid check, so this does
# not widen access to the control channel.
RuntimeDirectory=netshield
RuntimeDirectoryMode=0711
StateDirectory=netshield
StateDirectoryMode=0700
ReadWritePaths=/etc/netshield

PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
